[Unit]
Description=DegenBot Autonomous Solana Trading Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/degen-bot
Environment="PYTHONPATH=/home/ubuntu/degen-bot/src"
ExecStart=/home/ubuntu/degen-bot/.venv/bin/python src/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
